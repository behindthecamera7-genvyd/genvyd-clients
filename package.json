{
  "name": "genvyd-clients",
  "private": true,
  "version": "1.0.0",
  "description": "Client review portal for Genvyd (clients.genvyd.com)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:local": "wrangler d1 migrations apply genvyd-clients --local",
    "db:remote": "wrangler d1 migrations apply genvyd-clients --remote",
    "deploy": "wrangler d1 migrations apply genvyd-clients --remote && wrangler deploy",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.149.0"
  }
}
