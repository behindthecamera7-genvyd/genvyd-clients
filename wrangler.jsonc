{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "genvyd-clients",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",

  // Only reachable at clients.genvyd.com, which sits behind Cloudflare Access.
  // The workers.dev address is switched off so nobody can skip the login.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "clients.genvyd.com", "custom_domain": true }],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "genvyd-clients",
      "database_id": "ad0df7f0-35e3-4b59-8441-c68ffc3c0b9b",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    // Emails that see every client and the admin page. Comma separated.
    "ADMIN_EMAILS": "behindthecamera7@gmail.com",
    // Zero Trust team domain, e.g. "genvyd.cloudflareaccess.com".
    "TEAM_DOMAIN": "genvyd.cloudflareaccess.com",
    // Application Audience (AUD) tag from the clients.genvyd.com Access app.
    "POLICY_AUD": "8ceffaff2dd137d455ac00b5c43decffff072d931f4e6cd650941d211e4c6930",
    // Tunnel hostname that serves the Synology folder, e.g. "https://nas-media.genvyd.com".
    "MEDIA_ORIGIN": "https://nas-media.genvyd.com",
    // Email digest of client activity. Sent at most every 15 minutes, only when
    // something happened. Needs the RESEND_API_KEY secret; without it nothing is sent.
    "NOTIFY_TO": "behindthecamera7@gmail.com",
    // Sender for the admin digest, test and preview emails. Must be on the
    // Resend-verified subdomain notify.genvyd.com (the root genvyd.com is not verified).
    "NOTIFY_FROM": "Genvyd <alerts@notify.genvyd.com>",
    "PORTAL_URL": "https://clients.genvyd.com",
    // Welcome and "new work" emails to clients, from the Resend-verified subdomain
    // notify.genvyd.com. Empty = client emails off.
    "CLIENT_NOTIFY_FROM": "Genvyd <studio@notify.genvyd.com>",
    // Where clients' replies to those emails go.
    "CLIENT_REPLY_TO": "anthony@genvyd.com"
  },

  // Checks for new client activity every 15 minutes and emails a digest.
  "triggers": { "crons": ["*/15 * * * *"] }

  // Secrets (set in the Cloudflare dashboard, never in this file):
  //   MEDIA_CLIENT_ID      Access service token client ID for the NAS hostname
  //   MEDIA_CLIENT_SECRET  Access service token client secret
  //   RESEND_API_KEY       API key from resend.com, for the email digest
}
